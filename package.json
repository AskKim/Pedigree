{
  "name": "pedigree",
  "description": "Community Pedigree Project — React + Vite + TypeScript offline-first PWA (core app must always stay in React; android-wrapper/ is only a thin hybrid Kotlin WebView shell) | App Name: Community Pedigree | Repo: pedigree | Package Name: pedigree",
  "license": "AGPL-3.0-or-later",
  "homepage": "https://askkim.github.io/Pedigree/",
  "version": "0.1.0-alpha.3",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "verify:engine": "tsc -p tsconfig.engine.json --noEmit",
    "test": "vitest run",
    "verify:improvements": "tsx scripts/verify-improvements.ts",
    "verify:layers": "tsx scripts/audit-layers.ts",
    "verify:extraction": "tsx scripts/rehearse-engine-extraction.ts",
    "preflight": "node prompts/preflight/scripts/preflight-run-context.mjs",
    "preflight:gen": "node prompts/preflight/scripts/gen-preflight.mjs",
    "preflight:lint": "npx ajv -c prompts/preflight/manifest/manifest.schema.json -s prompts/preflight/manifest/preflight.manifest.json"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-react": "^6.3.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.17.0",
    "tesseract.js": "^7.0.0",
    "vite": "^8.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.16.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
